Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: Leader
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /leader/robot_description
      TF Prefix: leader
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: Follower
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /follower/robot_description
      TF Prefix: follower
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/Image
      Name: Wrist cam (green jaw)
      Enabled: true
      Topic:
        Value: /preview/wrist_cam
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: Overhead cam
      Enabled: true
      Topic:
        Value: /preview/overhead_cam
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: Wrist cam (black jaw)
      Enabled: true
      Topic:
        Value: /preview/leader_wrist_cam
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
        Durability Policy: Volatile
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.2
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.1
      Pitch: 0.5
      Yaw: 3.6
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
