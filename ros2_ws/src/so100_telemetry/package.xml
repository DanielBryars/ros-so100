<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so100_telemetry</name>
  <version>0.0.1</version>
  <description>Publish SO100 (Feetech STS3250) joint positions as sensor_msgs/JointState.</description>
  <maintainer email="daniel@bryars.com">danb</maintainer>
  <license>MIT</license>

  <!-- Build tooling for a Python (ament_python) package -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies: the Python client library and the message type we publish -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>so_arm_100_description</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
